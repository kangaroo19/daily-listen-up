# Public client values. Vite exposes only variables prefixed with VITE_.
# For release, copy these values from Firebase Console > Project settings > General > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Release API base URL format:
# https://asia-northeast3-daily-listen-up.cloudfunctions.net/api
# Local Emulator API base URL format:
# http://127.0.0.1:5001/daily-listen-up/asia-northeast3/api
VITE_APP_API_BASE_URL=
VITE_TOSS_APP_NAME=
VITE_TOSS_INTERSTITIAL_AD_GROUP_ID=
VITE_TOSS_RETRY_REWARDED_AD_GROUP_ID=
VITE_TOSS_SCRIPT_REWARDED_AD_GROUP_ID=
# Development default Toss banner ad group ID. Use a console-issued production value only at release time.
VITE_TOSS_BANNER_AD_GROUP_ID=
VITE_SKIP_ANSWER_RESULT_INTERSTITIAL=false

# Server-only values must not be added with the VITE_ prefix or used in client code.
# Examples: Toss access token, Firebase Admin credentials, raw Toss userKey.
FIREBASE_PROJECT_ID=daily-listen-up
TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im

# Local Emulator only: keep mTLS certificate/private key files outside the repository
# and point .env.local to those local filesystem paths.
TOSS_MTLS_CERT_PATH=
TOSS_MTLS_KEY_PATH=

# Release only: register these names in Firebase Secret Manager with firebase functions:secrets:set.
# Do not write real Toss production values in .env files, docs, logs, or git history.
TOSS_PROMOTION_CODE=
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
