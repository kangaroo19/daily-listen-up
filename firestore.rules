rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Replace this placeholder with the production admin UID during deployment.
      return request.auth != null && request.auth.uid in ['REPLACE_WITH_ADMIN_UID'];
    }

    match /quizzes/{quizDate} {
      allow read, write: if isAdmin();
    }

    match /userProgress/{progressId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
