SERVER_PORT=4000

# Toss integration placeholders
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Firebase integration placeholders
# Required for Firebase Admin initialization.
FIREBASE_PROJECT_ID=

# Optional for local emulator usage.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Optional service account env values for non-emulator server runtime.
# Keep the actual private key in a local .env file only. Use escaped newlines.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
